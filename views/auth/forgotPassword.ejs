<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | <%= appName %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/auth.css">
   <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body class="auth-page">
  <%- include('../partials/navbar') %>
  <main class="auth-shell">
    <section class="auth-card">
      <% if (typeof resetMode !== 'undefined' && resetMode) { %>
        <div class="hero-copy">
          <p class="eyebrow">Reset password</p>
          <h1>Choose a new password</h1>
        </div>
        <form class="form-stack" action="/auth/reset-password/<%= token %>" method="POST">
          <label>
            New password
            <input type="password" name="password" required>
          </label>
          <button class="primary-button" type="submit">Update password</button>
        </form>
      <% } else { %>
        <div class="hero-copy">
          <p class="eyebrow">Account recovery</p>
          <h1>Forgot your password?</h1>
          <p>Enter your email to create a reset link during development.</p>
        </div>
        <form class="form-stack" action="/auth/forgot-password" method="POST">
          <label>
            Email
            <input type="email" name="email" placeholder="you@example.com" required>
          </label>
          <button class="primary-button" type="submit">Create reset link</button>
        </form>
        <% if (typeof resetLink !== 'undefined' && resetLink) { %>
          <p class="notice-box">Reset link: <a href="<%= resetLink %>"><%= resetLink %></a></p>
        <% } %>
      <% } %>
      <div class="auth-links">
        <a href="/auth/login">Back to login</a>
      </div>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>